#define LED_BLINK PB0  // Пин 5 (PB0) — светодиод, который должен мигать
#define LED_BUTTON PB1 // Пин 6 (PB1) — светодиод, управляемый кнопкой
#define BUTTON     PB2 // Пин 7 (PB2) — кнопка, подтянутая к GND

void setup() {
  // Настраиваем пины светодиодов как выходы
  pinMode(LED_BLINK, OUTPUT);
  pinMode(LED_BUTTON, OUTPUT);
  
  // Настраиваем пин кнопки как вход с внутренней подтяжкой к VCC (5V).
  // Пока кнопка не нажата, на пине логическая 1 (HIGH). При нажатии — 0 (LOW).
  pinMode(BUTTON, INPUT_PULLUP);
}

void loop() {
  // --- ШАГ 1: Быстрый опрос кнопки ---
  // Проверяем состояние кнопки. Этот блок выполняется мгновенно.
  if (digitalRead(BUTTON) == LOW) {
    digitalWrite(LED_BUTTON, HIGH); // Кнопка нажата — зажигаем второй светодиод
  } else {
    digitalWrite(LED_BUTTON, LOW);  // Кнопка отпущена — гасим второй светодиод
  }

  // --- ШАГ 2: Включаем первый светодиод и ЗАВИСАЕМ ---
  digitalWrite(LED_BLINK, HIGH); // Подаем HIGH на PB0, светодиод загорается

  /* 
   * ОШИБКА LОGIC / БЛОКИРОВКА:
   * Вызов delay(2000) полностью останавливает выполнение программы на 2 секунды.
   * Микроконтроллер не выполняет никакой другой код, включая опрос кнопки из ШАГА 1.
   * Если сейчас нажать или отпустить кнопку — плата этого просто не увидит.
   */
  delay(2000); 

  // --- ШАГ 3: Выключаем первый светодиод и СНОВА ЗАВИСАЕМ ---
  digitalWrite(LED_BLINK, LOW);  // Подаем LOW на PB0, светодиод гаснет

  /* 
   * Повторная блокировка ещё на 2 секунды.
   * В общей сложности за один круг loop() микроконтроллер "слепнет" на 4 секунды.
   */
  delay(2000); 
}
